  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String?
  role      UserRole @default(CONTRIBUTOR)
  avatarUrl String?
  isActive  Boolean  @default(true)
  /// Copied into the session token at sign-in; rotated when role, active flag
  /// or password change, so existing sessions stop working at once.
  securityStamp String @default(uuid())
  /// An admin chose this user's password; they must replace it before anything else.
  mustChangePassword Boolean @default(false)
  /// AES-GCM envelope (src/lib/crypto.ts) of the authenticator secret. With
  /// totpEnabledAt null it is a pending enrolment; set, it is live.
  totpSecretEnc    String?
  totpEnabledAt    DateTime?
  /// The 30-second step of the last accepted code: a code for an earlier or
  /// equal step is refused, so an intercepted code can't be replayed.
  totpLastUsedStep Int?
  /// The project opened when no other is chosen (see src/lib/current-project.ts).
  defaultProjectId String?
  defaultProject   Project? @relation("UserDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)
  projectMemberships ProjectMember[] @relation("MemberUser")
  membershipsAdded   ProjectMember[] @relation("MemberAddedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  taskAssignments TaskAssignment[]
  resources       Resource[]
  createdProjects Project[]        @relation("ProjectCreator")
  livingLabCosts  LivingLabCost[]
  cashTransactions CashTransaction[] @relation("CashTransactionCreator")
  journalsCreated  JournalEntry[]    @relation("JournalCreator")
  journalsPosted   JournalEntry[]    @relation("JournalPoster")
  invoicesCreated  Invoice[]         @relation("InvoiceCreator")
  invoicesApproved Invoice[]         @relation("InvoiceApprover")
  creditNotesCreated  CreditNote[]       @relation("CreditNoteCreator")
  creditNotesApproved CreditNote[]       @relation("CreditNoteApprover")
  creditAllocations   CreditAllocation[]
  customerPayments    CustomerPayment[]  @relation("PaymentCreator")
  statementImports    StatementImport[]  @relation("StatementImporter")
  reconciliations     BankReconciliation[]
  statementUndos      StatementImport[]  @relation("StatementUndoer")
  paymentAllocations  PaymentAllocation[]
  recoveryCodes       RecoveryCode[]
  stepUps             StepUpVerification[]

  @@index([role])
  @@index([isActive])
  @@index([defaultProjectId])
  @@map("users")
}

/// One-time codes for a lost authenticator. Only a SHA-256 of an 80-bit code is
/// kept (src/lib/mfa/recovery.ts); a used code keeps its row, stamped.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Proof that *this session* recently passed a second-factor check, so a stolen
/// session cannot approve invoices or change bank details without the phone.
/// Keyed by the session token's id (not the user): a check in one browser must
/// not unlock another. See src/lib/mfa/step-up.ts.
model StepUpVerification {
  sessionId  String   @id
  userId     String
  verifiedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verifiedAt])
  @@map("step_up_verifications")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  logoUrl     String?
  createdBy   String
  createdAt   DateTime  @default(now())
  // Manual adjustment for spend that predates or falls outside Task/Living
  // Lab cost tracking — e.g. money spent before this system was in use.
  // Added into the funding runway calc alongside tracked actuals.
  historicalSpend Decimal @default(0) @db.Decimal(12, 2)
  /// Archived projects leave the switcher and the portfolio totals but keep
  /// all their data; archive, never delete, once a project holds money.
  archivedAt  DateTime?
  archivedBy  String?

  creator        User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  defaultFor     User[]          @relation("UserDefaultProject")
  members        ProjectMember[]
  fundingRecords FundingRecord[]
  livingLabs     LivingLab[]
  phases         Phase[]
  tags           Tag[]
  milestones     Milestone[]
  tasks          Task[]
  resources      Resource[]
  customFieldDefinitions CustomFieldDefinition[]
  cashTransactions       CashTransaction[]

  @@index([archivedAt])
  @@map("projects")
}

/// Who may open a project, and the most they may do in it (S2.7). Admins reach
/// every project without a row. For everyone else a project exists only if they
/// are a member: `activeProjects()` in src/lib/current-project.ts is the one
/// reader, and `requireProjectAccess` / `requireEntityAccess` in
/// src/lib/project-access.ts guard the writes. A member's effective role in the
/// project is the lower of their account role and this one.
model ProjectMember {
  projectId String
  userId    String
  role      UserRole
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Phase {
  id         String    @id @default(uuid())
  projectId  String
  name       String
  orderIndex Int       @default(0)
  startDate  DateTime?
  endDate    DateTime?
  color      String?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones     Milestone[]
  fundingRecords FundingRecord[]
  cashTransactions CashTransaction[]

  @@index([projectId])
  @@map("phases")
}

model Tag {
  id        String @id @default(uuid())
  projectId String
  name      String
  color     String @default("#6366f1")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTags        TaskTag[]
  milestoneTags  MilestoneTag[]
  resourceTags   ResourceTag[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tags")
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  phaseId     String?
  parentId    String?
  code        String
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  status      MilestoneStatus @default(NOT_STARTED)
  priority    Priority        @default(MED)
  estBudget   Decimal?        @db.Decimal(12, 2)
  actualSpend Decimal?        @db.Decimal(12, 2)
  orderIndex  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase              Phase?              @relation(fields: [phaseId], references: [id])
  parent             Milestone?          @relation("MilestoneChildren", fields: [parentId], references: [id])
  children           Milestone[]         @relation("MilestoneChildren")
  tasks              Task[]
  resourceMilestones ResourceMilestone[]
  milestoneTags      MilestoneTag[]
  fundingTranches    FundingTranche[]
  cashTransactions   CashTransaction[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([phaseId])
  @@index([parentId])
  @@map("milestones")
}

model Task {
  id           String     @id @default(uuid())
  milestoneId  String
  projectId    String
  code         String
  title        String
  description  String?
  startDate    DateTime
  dueDate      DateTime
  percentDone  Int        @default(0)
  status       TaskStatus @default(BACKLOG)
  priority     Priority   @default(MED)
  estBudget    Decimal?   @db.Decimal(12, 2)
  actualSpend  Decimal?   @db.Decimal(12, 2)
  extCosts     Decimal?   @db.Decimal(12, 2)
  costCategoryId String?
  costCategory  CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)
  notes        String?    @db.Text
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  resourceId      String?

  milestone       Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskAssignments TaskAssignment[]
  taskTags        TaskTag[]
  livingLabCosts  LivingLabCost[]
  resource        Resource? @relation(fields: [resourceId], references: [id])

  @@unique([projectId, code])
  @@index([milestoneId])
  @@index([projectId])
  @@index([status])
  @@index([costCategoryId])
  @@index([resourceId])
  @@map("tasks")
}

model TaskAssignment {
