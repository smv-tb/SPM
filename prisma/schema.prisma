  currency     String         @default("GBP")
  coverageDesc String?        @db.Text
  phaseId      String?
  verified     Boolean        @default(false)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())

  stage          FundingStage?
  probability    Int?
  deadline       DateTime?
  nextAction     String?
  nextActionDate DateTime?
