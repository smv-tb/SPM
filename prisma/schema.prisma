  fundingRecord FundingRecord @relation(fields: [fundingRecordId], references: [id], onDelete: Cascade)
  milestone     Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([fundingRecordId])
  @@index([dueDate])
  @@map("funding_tranches")
}

