# Environment Variables for smartvie-pm
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to version control.

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/smartvie_pm?schema=public"
# Recommended in production: DATABASE_URL is a least-privilege role (rows only), and migrations
# run as the schema owner. Leave this unset for a simple single-role setup.
# See docs/security/DB-ROLES.md.
# MIGRATION_DATABASE_URL="postgresql://owner:password@localhost:5432/smartvie_pm?schema=public"

# NextAuth Authentication (v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-in-production"

# E2E Testing Credentials (create a test user in your DB)
E2E_EMAIL="test@example.com"
E2E_PASSWORD="your-test-password"

# Optional: Deployment URL for production builds
NEXTAUTH_URL="http://localhost:3000"

# Optional: Logging level
LOG_LEVEL="info"

# Hermes MCP Agent — bearer token required on the /api/hermes HTTP endpoint
# (also used by `yarn hermes`, the local stdio dev entrypoint)
# Generate with: openssl rand -base64 32
HERMES_API_TOKEN="hermes-token-change-in-production"

# Security alerts (S5.2) — optional. Each alert is a JSON POST to this URL (e.g. an n8n
# webhook that emails the admins), signed in the X-Smartvie-Signature header
# (sha256=<hmac of the body>) when a secret is set. Unset = alerts are only logged.
SECURITY_ALERT_WEBHOOK_URL=""
# Generate with: openssl rand -base64 32
SECURITY_ALERT_WEBHOOK_SECRET=""

# Deployment (only needed for ./deploy.sh; there is deliberately no default host)
# SSH_USER="deploy"
# SSH_HOST="your-server"
# SSH_PORT="22"
# REMOTE_DIR="/opt/smartvie-pm"

# Optional support contact shown in the sidebar (hidden when empty). Read at
# build time: set it before `docker compose build`.
# NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
