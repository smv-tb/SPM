  role         String
  department   String?
  type         ResourceType   @default(CORE)
  tagFocus     String?
  availability String?
  dayRate      Decimal?       @db.Decimal(10, 2)
  daysPerMonth Int?
  yearlyCost   Decimal?       @db.Decimal(12, 2)
  status       ResourceStatus @default(ACTIVE)
  notes        String?
  userId       String?

